# 当前生效的启动器配置 —— 唯一真相源（人写机读）
#
# ── 谁改它 ──────────────────────────────────────────────────────────
#   你。启动器【只读不写】。要把某个试过的版本「转正」，由你把下面 version
#   那一行改掉再重启 —— 而不是让工具替你改。理由：转正是人的决定，
#   且「谁写它 = 谁是唯一真相源」；让工具也能写，立刻长出「文件说的和
#   参数说的不一样」。
#
# ── 为什么是 TOML 而不是 YAML ───────────────────────────────────────
#   1. 有注释（JSON 没有）—— 这个文件的用途一半是「在旁边写为什么」
#   2. 语义严格：错的东西会【报错】，不会静默变成另一个意思
#      （YAML 1.1 里 `NO`/`on`/`off` 是布尔 —— 挪威问题；`12:30` 是六百
#       十进制的 750；`1.10` 会变成 `1.1`；重复键静默取最后一个）
#   3. 读它只需要标准库 tomllib，零第三方依赖
#
# ── 键为什么用英文 ──────────────────────────────────────────────────
#   与代码里的常量同名（main_port / home_prefix …），可以 grep 对照。
#   加一套中文键 = 让同一件事多出一个拼写维度，正是版本标记审计里那类腐坏。

version = "v0.2.0-rc.2"
# 基座版本。这个字符串必须【同时】存在：
#   原始代码研究/<version>/                         检出（目录名逐字节相同）
#   启动器配置和日志/版本信息说明/<version>.toml     配套说明
# 注意开头这个 v：目录名与上游 tag 的关系见版本信息说明里的 [upstream]。

home_prefix = "dsh-domus"
# home 目录名 = <home_prefix>-<version 去掉【一个】前导 v>
#   例：v0.2.0-rc.2 → dsh-domus-0.2.0-rc.2

main_port = 9007
# 主运行实例的端口。前台/后台都用它。

try_port_from = 9008
# --try 时自动找空闲端口的起点（往上一共扫 60 个）。

archive_ttl_days = 7
# 运行记录归档的保留期（天），从【归档时刻】起算 —— 不是从实例启动时刻。
# 为什么按归档时刻：否则一个跑了一周的实例，一归档就被立刻删掉，
#   post-mortem 窗口为零。
# 注意分界：惰性对账【只搬不删】（死实例移进 运行记录/历史/，无损）；
#   真正【删除】只由显式的 --gc 执行，且默认干跑。
#   --status 会把「已过期 N 条」报出来，但不擅自动手。
