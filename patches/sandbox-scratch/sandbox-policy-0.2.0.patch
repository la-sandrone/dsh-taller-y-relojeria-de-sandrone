+/** Win32 device names that are illegal as a path component, in **any** spelling of the name. */
+const WIN32_RESERVED = new Set([
+  'CON', 'PRN', 'AUX', 'NUL',
+  ...Array.from({ length: 9 }, (_, i) => `COM${i + 1}`),
+  ...Array.from({ length: 9 }, (_, i) => `LPT${i + 1}`),
+])
+
+/**
+ * Reject a scratch root whose spelling the classic Win32 path APIs cannot open.
+ *
+ * The traditional APIs (CreateFileW and friends) fail on names that POSIX tools
+ * happily create — `CON`, `NUL`, `COM1`, a component ending in a dot or a space.
+ * Failing here, at resolution time, turns "the agent's first write silently lands
+ * somewhere unusable" into a loud boot error. Only meaningful on Windows: a
+ * Win32-illegal name is a perfectly legal POSIX name, so this is deliberately
+ * not applied elsewhere.
+ */
+function isWin32LegalComponent(component: string): boolean {
+  if (component.length === 0) return false
+  // Win32 strips trailing dots/spaces before matching a device name, so strip the
+  // same way for the check: "CON." and "CON " are also the device.
+  const bare = component.replace(/[. ]+$/, '')
+  if (bare.length === 0) return false // ".", ".." or a name made only of dots/spaces
+  const stem = bare.split('.', 1)[0]!.toUpperCase()
+  return !WIN32_RESERVED.has(stem)
+}
+
+/**
+ * Resolve the optional `scratchRoot` from deployment config to an absolute path.
+ *
+ * Two things `resolveWorkspaceRoot` does not need to do:
+ *  1. expand environment references — `%TEMP%` on Windows, `$TMPDIR` elsewhere —
+ *     so the deployment can spell the platform temp area without hardcoding it;
+ *  2. refuse a spelling that resolves to something the host cannot use.
+ *
+ * Throws on an unusable spelling (fail-loud at boot, never a silent skip).
+ */
+function resolveScratchRoot(path: string): string {
+  // Precedence: explicit config > DSH_SCRATCH_ROOT > platform default.
+  // The env hop exists because the launcher owns the scratch directory's
+  // lifecycle (it must `mkdir -p` the host path before any sandboxed run —
+  // bwrap refuses a bind whose source is missing), and the launcher already
+  // hands the instance its identity through the environment (DSH_HOME &c).
+  // An implementation detail, not a user knob: the deployment spells the root
+  // in config; this lets the launcher keep the two in lockstep.
+  // (This is the harness process's own env, NOT the sanitized MCP child env.)
+  const expanded = path.replace(
+    /%([A-Za-z_][A-Za-z0-9_]*)%|\$\{([A-Za-z_][A-Za-z0-9_]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)/g,
+    (_whole, win: string, braced: string, bare: string) => {
+      const name = win ?? braced ?? bare
+      const value = process.env[name]
+      if (value === undefined || value === '') {
+        throw new Error(
+          `sandbox-policy: scratch root ${JSON.stringify(path)} references undefined environment variable ${name}`,
+        )
+      }
+      return value
+    },
+  )
+  if (!isAbsolute(expanded)) {
+    throw new Error(
+      `sandbox-policy: scratch root must be an absolute execution-world path, got ${JSON.stringify(expanded)}`,
+    )
+  }
+  if (process.platform === 'win32') {
+    // Split on both separators: the deployment may spell it either way.
+    const bad = expanded.split(/[\\/]+/).find((component) => !isWin32LegalComponent(component))
+    if (bad !== undefined) {
+      throw new Error(
+        `sandbox-policy: scratch root component ${JSON.stringify(bad)} is not a legal Win32 path name ` +
+          '(reserved device name, or a trailing dot/space) — the classic Win32 APIs cannot open it',
+      )
+    }
+  }
+  return expanded
+}
+
+/** The scratch area default per platform — `%TEMP%` spelling on Windows. */
+function defaultScratchRoot(): string {
+  return process.platform === 'win32' ? '%TEMP%\\.dsh-tmp' : '/tmp/.dsh-tmp'
+}
