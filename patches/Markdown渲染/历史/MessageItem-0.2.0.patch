+/**
+ * 本地补丁（dsh-user-markdown）的核心判定：无引用装饰时整条走 Markdown，否则原样返回。
+ *
+ * **不复刻官方正则**，而是问官方自己的返回值：
+ *   · 官方 `projectUserText` 无装饰时返回单个 `<span className={css.plainRun}>{text}</span>`
+ *     （见 `ui-primitives/src/user-text.tsx` 末尾的 `if (parts.length === 0) …`）
+ *   · 有装饰（`@文件` / 会话引用 / skill 名）时返回 Fragment（多片段）
+ * ⇒ 所以「是单元素 **且** children 就是原文」即「无装饰」。
+ *
+ * **安全失败方向**：官方若改实现（例如无装饰也返回 Fragment），判定失效 → 退回纯文本，
+ * 不会渲染坏。这是刻意选择的保守姿态。
+ *
+ * ⚠️ 参数**必须原样透传**（0.2.0 比 0.1.5 多了 `slashKind` 与 `references`）：
+ *    少传一个，`/` 引用与 skill chip 的点击就会哑掉。
+ */
+function projectUserContent(
+  text: string,
+  referenceLabels: readonly string[],
+  skillNames: readonly string[],
+  slashKind: 'skill' | 'command',
+  references: Pick<ChatNodeOwnerProps, 'openFile' | 'openSkill'> | undefined,
+  labels: MarkdownLabels,
+): ReactNode {
+  const projected = projectUserText(text, referenceLabels, skillNames, slashKind, references)
+  const undecorated = isValidElement(projected)
+    && (projected.props as { children?: unknown }).children === text
+  return undecorated ? <MarkdownText text={text} labels={labels} /> : projected
+}
