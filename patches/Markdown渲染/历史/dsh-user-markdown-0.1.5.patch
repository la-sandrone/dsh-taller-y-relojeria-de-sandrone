+/**
+ * dsh-user-markdown 补丁 —— 用户气泡文本的 Markdown 渲染。
+ *
+ * 无引用装饰（@文件 / 会话引用 / 已加载技能名）时按 Markdown 渲染；含引用 token
+ * 时整条退回官方 chip 投影：引用扫描是纯文本层的、不理解 Markdown 结构，强行走
+ * Markdown 会把代码块与表格里的 @、/ 误抠成 chip 导致语法腰斩。判定复用官方
+ * projectUserText 的返回值结构（无装饰 ⟺ 单个 span 且 children 就是原文），
+ * 不复制官方正则；官方改实现时安全退回纯文本。
+ * @param text - 消息的模型可见文本。
+ * @param referenceLabels - 相邻 recall 关联的会话引用标签。
+ * @param skillNames - 该消息已加载的技能名。
+ * @param labels - Markdown 围栏与脚注的本地化文案。
+ * @returns 引用 chip 投影，或整段的 Markdown 渲染。
+ */
+function projectUserContent(
+  text: string,
+  referenceLabels: readonly string[],
+  skillNames: readonly string[],
+  labels: MarkdownLabels,
+): ReactNode {
+  const projected = projectUserText(text, referenceLabels, skillNames)
+  const undecorated = isValidElement(projected)
+    && (projected.props as { children?: unknown }).children === text
+  return undecorated ? <MarkdownText text={text} labels={labels} /> : projected
+}
